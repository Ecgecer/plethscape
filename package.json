{
  "name": "plethscape",
  "version": "1.0.0",
  "description": "Interactive 3D anatomy and educational PPG simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "model:build": "python3 scripts/fetch_bodyparts3d.py && blender --background --python scripts/build_bodyparts_atlas.py && blender --background --python scripts/build_neutral_skin.py",
    "format": "prettier --write src vite.config.ts playwright.config.ts README.md",
    "model:skin": "blender --background --python scripts/build_neutral_skin.py"
  },
  "keywords": ["ppg", "photoplethysmography", "3d", "physiology", "education", "three.js"],
  "author": "Sameer Sontakey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sontakey/plethscape.git"
  },
  "homepage": "https://chatppg.com/plethscape",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
